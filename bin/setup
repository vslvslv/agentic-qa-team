#!/usr/bin/env bash
# bin/setup — Install qa-agentic-team skills and agents as symlinks into ~/.claude/
#
# Usage:
#   bash bin/setup                 # link skills + agents; ask before installing the Stop hook
#   bash bin/setup --with-hook     # also install the Stop hook without asking
#   bash bin/setup --no-hook       # never touch ~/.claude/settings.json
#   bash bin/setup --hook-only     # only install/update the Stop hook
#   bash bin/setup --force         # replace existing non-symlink skills/agents of the same name
#                                  # (they are moved to ~/.claude/qa-agentic-team-backup-<ts>/)
#
# What it creates (all symlinks into this repo, so `git pull` updates them):
#   ~/.claude/qa-agentic-team          → repo root   (stable path used by hooks and agents)
#   ~/.claude/skills/<skill>           → repo/<skill>  for every top-level dir with a SKILL.md
#   ~/.claude/agents/qa-*.md           → repo/.claude/agents/qa-*.md
#
# Remove everything again with: bash bin/uninstall
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLAUDE_HOME="${CLAUDE_HOME_DIR:-$HOME/.claude}"
CLAUDE_SKILLS="${CLAUDE_SKILLS_DIR:-$CLAUDE_HOME/skills}"
CLAUDE_AGENTS="${CLAUDE_AGENTS_DIR:-$CLAUDE_HOME/agents}"
CLAUDE_SETTINGS="${CLAUDE_SETTINGS_FILE:-$CLAUDE_HOME/settings.json}"
STABLE_LINK="$CLAUDE_HOME/qa-agentic-team"

HOOK_PREF="prompt"     # prompt | install | skip
INSTALL_LINKS=1
FORCE=0

for arg in "$@"; do
  case "$arg" in
    --with-hook)  HOOK_PREF="install" ;;
    --no-hook)    HOOK_PREF="skip" ;;
    --hook-only)  HOOK_PREF="install"; INSTALL_LINKS=0 ;;
    --force)      FORCE=1 ;;
    --short-names) ;;  # accepted for backwards compatibility; this is the only mode
    --namespaced)
      echo "ERROR: --namespaced was removed: Claude Code only discovers skills one level" >&2
      echo "       below ~/.claude/skills, so a single repo-root link exposes no skills." >&2
      exit 1 ;;
    *)
      echo "ERROR: unknown argument: $arg" >&2
      sed -n '3,10p' "$0" >&2
      exit 1 ;;
  esac
done

echo "qa-agentic-team $(tr -d '[:space:]' < "$REPO_DIR/VERSION") — Setup"
echo "========================================"
echo "Repo:     $REPO_DIR"
echo "Skills:   $CLAUDE_SKILLS"
echo "Agents:   $CLAUDE_AGENTS"
echo ""

BACKUP_DIR="$CLAUDE_HOME/qa-agentic-team-backup-$(date +%Y%m%d-%H%M%S)"
CONFLICTS=0

# _link <source> <dest> <label>
# Creates or refreshes a symlink. Never deletes a real file or directory:
# without --force it reports a conflict; with --force it moves it to BACKUP_DIR.
_link() {
  local src="$1" dest="$2" label="$3"
  if [ -L "$dest" ]; then
    if [ "$(readlink "$dest")" = "$src" ]; then
      echo "  OK     $label"
      return 0
    fi
    rm "$dest"
    ln -s "$src" "$dest"
    echo "  UPDATE $label → $src"
    return 0
  fi
  if [ -e "$dest" ]; then
    if [ "$FORCE" = "1" ]; then
      mkdir -p "$BACKUP_DIR"
      mv "$dest" "$BACKUP_DIR/"
      ln -s "$src" "$dest"
      echo "  BACKUP $label (old copy moved to $BACKUP_DIR/)"
      return 0
    fi
    echo "  SKIP   $label — $dest exists and is not a symlink (re-run with --force to back it up and replace it)"
    CONFLICTS=$((CONFLICTS + 1))
    return 0
  fi
  ln -s "$src" "$dest"
  echo "  LINK   $label"
}

if [ "$INSTALL_LINKS" = "1" ]; then
  mkdir -p "$CLAUDE_HOME" "$CLAUDE_SKILLS" "$CLAUDE_AGENTS"

  echo "Stable path (hooks and agents resolve scripts through it):"
  _link "$REPO_DIR" "$STABLE_LINK" "$STABLE_LINK"
  echo ""

  echo "Skills:"
  for skill_md in "$REPO_DIR"/*/SKILL.md; do
    skill_dir="$(dirname "$skill_md")"
    name="$(basename "$skill_dir")"
    _link "$skill_dir" "$CLAUDE_SKILLS/$name" "/$name"
  done
  echo ""

  echo "Agents:"
  for agent in "$REPO_DIR"/.claude/agents/qa-*.md; do
    [ -f "$agent" ] || continue
    _link "$agent" "$CLAUDE_AGENTS/$(basename "$agent")" "$(basename "$agent" .md)"
  done
  echo ""
fi

# ---- Stop hook (re-run nudge) ---------------------------------------------------
HOOK_SCRIPT="$REPO_DIR/bin/qa-team-suggest-rerun"

_hook_already_installed() {
  [ -f "$CLAUDE_SETTINGS" ] || return 1
  jq -e --arg cmd "$HOOK_SCRIPT" \
    'first(.hooks.Stop[]?.hooks[]? | select(.type == "command" and .command == $cmd))' \
    "$CLAUDE_SETTINGS" >/dev/null 2>&1
}

_install_hook() {
  chmod +x "$HOOK_SCRIPT" 2>/dev/null || true
  if ! command -v jq >/dev/null 2>&1; then
    echo "  WARN   jq not installed — add this entry under .hooks.Stop in $CLAUDE_SETTINGS yourself:"
    printf '         {"hooks": [{"type": "command", "command": "%s"}]}\n' "$HOOK_SCRIPT"
    return 0
  fi
  mkdir -p "$(dirname "$CLAUDE_SETTINGS")"
  [ -f "$CLAUDE_SETTINGS" ] || echo '{}' > "$CLAUDE_SETTINGS"
  if _hook_already_installed; then
    echo "  OK     Stop hook already installed"
    return 0
  fi
  cp "$CLAUDE_SETTINGS" "$CLAUDE_SETTINGS.qa-agentic-team.bak"
  local tmp
  tmp="$(mktemp)"
  # Stop events take no matcher. Drop any earlier entry for this script, then append.
  jq --arg cmd "$HOOK_SCRIPT" '
    .hooks.Stop = (
      ((.hooks.Stop // []) | map(select(([.hooks[]?.command] | index($cmd)) | not)))
      + [{hooks: [{type: "command", command: $cmd}]}]
    )' "$CLAUDE_SETTINGS" > "$tmp"
  mv "$tmp" "$CLAUDE_SETTINGS"
  echo "  HOOK   installed Stop → $HOOK_SCRIPT (backup: $CLAUDE_SETTINGS.qa-agentic-team.bak)"
}

echo "Stop hook (prints a re-run nudge when test files changed since the last /qa-* run):"
case "$HOOK_PREF" in
  install) _install_hook ;;
  skip)    echo "  SKIP   (--no-hook). Install later with: bash bin/setup --hook-only" ;;
  prompt)
    if command -v jq >/dev/null 2>&1 && _hook_already_installed; then
      echo "  OK     already installed"
    elif [ -t 0 ]; then
      printf "  Add it to %s? [y/N] " "$CLAUDE_SETTINGS"
      read -r reply || reply=""
      case "$reply" in
        y|Y|yes|YES|Yes) _install_hook ;;
        *) echo "  SKIP   (install later with: bash bin/setup --hook-only)" ;;
      esac
    else
      # Never edit global settings unattended unless asked to with --with-hook.
      echo "  SKIP   (non-interactive; pass --with-hook to install it)"
    fi
    ;;
esac

if [ "$CONFLICTS" -gt 0 ]; then
  echo ""
  echo "WARN: $CONFLICTS item(s) were skipped because a non-symlink with the same name exists."
fi

echo ""
echo "Installed skills:"
for skill_md in "$REPO_DIR"/*/SKILL.md; do
  printf '  /%s\n' "$(basename "$(dirname "$skill_md")")"
done
echo ""
echo "Start with /qa-team in your project. Uninstall with: bash $REPO_DIR/bin/uninstall"
